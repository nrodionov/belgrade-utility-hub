# =============================================================================
# Belgrade Utility Hub — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (see .gitignore).
#
# Usage:
#   Development:  docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env up -d
#   Production:   docker compose -f docker-compose.prod.yml --env-file .env up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 15)
# -----------------------------------------------------------------------------
POSTGRES_USER=belgrade_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=belgrade_monitor

# Full connection string (used by scraper & web).
# DEV:  postgresql://belgrade_user:password@belgrade_db_hm:5432/belgrade_monitor
# PROD: postgresql://belgrade_user:password@belgrade_db:5432/belgrade_monitor
DATABASE_URL=postgresql://belgrade_user:your_secure_password_here@db:5432/belgrade_monitor

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
TZ=Europe/Belgrade

# Web server host port (nginx proxies to this)
# DEV:  8002  (nginx hm.ss.ru → 127.0.0.1:8002)
# PROD: 8000  (nginx bg.ss.ru → 127.0.0.1:8000)
WEB_PORT=8000

# -----------------------------------------------------------------------------
# Outbound Proxy (REQUIRED for scraper)
# All scraper HTTP requests must route through v.ss.ru:8888
# -----------------------------------------------------------------------------
HTTP_PROXY=http://v.ss.ru:8888
HTTPS_PROXY=http://v.ss.ru:8888

# -----------------------------------------------------------------------------
# Groq API Key (Translation: Serbian → Russian/English)
# Get key at: https://console.groq.com
# Use DIFFERENT keys for dev/prod to track usage independently.
# Model: qwen/qwen3.8-27b (configured in scraper/main.py)
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# Optional: Resource Limits Override
# Only needed if you want to adjust the hardcoded limits (0.5 CPU, 512MB RAM)
# -----------------------------------------------------------------------------
# SCRAPER_CPU_LIMIT=0.50
# SCRAPER_MEM_LIMIT=512M